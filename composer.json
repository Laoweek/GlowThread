{
	"description": "Comments under wiki articles for MediaWiki, with likes, reports and moderation",
	"type": "mediawiki-extension",
	"license": "MIT",
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "52.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"scripts": {
		"test": [
			"parallel-lint . --exclude vendor --exclude node_modules --exclude dev --exclude private",
			"@phpcs"
		],
		"fix": [
			"phpcbf"
		],
		"phpcs": "phpcs -sp --cache"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
